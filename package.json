{
  "name": "opencode2-mcp",
  "version": "0.4.0",
  "description": "MCP server that delegates bounded tasks to local OpenCode 2, with portable execution and read-only project analysis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuxiaofengone/opencode-mcp.git"
  },
  "type": "module",
  "main": "server.mjs",
  "bin": {
    "opencode2-mcp": "server.mjs"
  },
  "files": [
    "server.mjs",
    "src",
    "scripts",
    "README.md",
    "README.en.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs"
  ],
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/server.test.mjs test/events.test.mjs test/runner.test.mjs",
    "test:live": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/liuxiaofengone/opencode-mcp#readme",
  "bugs": {
    "url": "https://github.com/liuxiaofengone/opencode-mcp/issues"
  }
}
